SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=documents
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:6543/postgres
DEMO_KNOWLEDGE_CONVERSATION_ID=
OPENAI_API_KEY=your-openai-api-key
GENERATION_BASE_URL=https://api.openai.com/v1
GENERATION_MODEL=gpt-4.1
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=768
AI_REQUEST_TIMEOUT_MS=60000
ENABLE_WEB_RESEARCH=true
MAX_FILE_SIZE_MB=10
MAX_FILES_PER_CONVERSATION=5
MAX_CHUNKS_PER_CONVERSATION=100
TOP_K_CHUNKS=10
SIMILARITY_THRESHOLD=0.72
PORT=8080
CORS_ORIGINS=http://localhost:3000
SEED_API_URL=http://localhost:8080/api
SEED_USER_PASSWORD=DemoPass!2026
