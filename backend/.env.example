SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=documents
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:6543/postgres
DEMO_KNOWLEDGE_CONVERSATION_ID=
GEMINI_API_KEY=your-gemini-api-key
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_GENERATION_MODEL=gemini-2.5-flash-lite
GEMINI_REQUEST_TIMEOUT_MS=60000
MAX_FILE_SIZE_MB=10
MAX_FILES_PER_CONVERSATION=5
MAX_CHUNKS_PER_CONVERSATION=100
TOP_K_CHUNKS=10
SIMILARITY_THRESHOLD=0.72
PORT=8080
CORS_ORIGINS=http://localhost:3000
